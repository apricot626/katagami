!.claude/hooks/
.claude/hooks/*
!.claude/hooks/session-start.sh
node_modules/
package-lock.json
package.json

# 認証鍵は絶対にコミットしない（公開リポジトリです）
*service-account*.json
*-sa.json
gcp-key*.json
client_secret*.json
