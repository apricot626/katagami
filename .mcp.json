{
  "mcpServers": {
    "google-analytics": {
      "command": "uvx",
      "args": ["analytics-mcp"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS:-/home/user/.config/katagami/ga-service-account.json}",
        "GOOGLE_PROJECT_ID": "${GOOGLE_PROJECT_ID:-}"
      }
    }
  }
}
